{
  "system_id": "example-review-assistant",
  "version": "1.0.0",
  "owner": "Example AI System Owner",
  "purpose": "Draft review assistance with no autonomous external action",
  "data_classification": "public-and-internal",
  "models": [
    {
      "id": "example-model",
      "provider": "example-provider",
      "revision": "0123456789abcdef0123456789abcdef01234567",
      "trust_remote_code": false
    }
  ],
  "tools": [
    {
      "id": "reviewed-record-writer",
      "operations": ["write"],
      "human_approval": true
    }
  ],
  "secret_reference": "secret://approved-broker/example-ai-token",
  "controls": {
    "deny_unknown_tools": true,
    "network_egress": "deny-by-default",
    "prompt_injection_defense": true,
    "output_validation": true,
    "secrets_via_broker": true,
    "logging_redaction": true,
    "kill_switch": true,
    "model_change_approval": true,
    "vendor_inventory": true,
    "training_data_provenance": true,
    "resilience": {
      "incident_runbook": "IR-AI-001",
      "rto_minutes": 240,
      "rpo_minutes": 60,
      "restore_tested_at": "2026-09-01T00:00:00Z"
    },
    "crypto_inventory": [
      {
        "use": "service transport",
        "algorithm": "TLS 1.3 approved platform policy",
        "owner": "Security engineering",
        "migration_trigger": "agency policy, cryptanalytic break, or platform deprecation"
      }
    ]
  }
}
